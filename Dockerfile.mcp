# syntax=docker/dockerfile:1

FROM golang:1.25-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN GOWORK=off go build -trimpath -ldflags="-s -w" -o /out/myflowhub-mcp ./cmd/myflowhub-mcp

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/myflowhub-mcp /usr/local/bin/myflowhub-mcp
COPY docker/mcp-entrypoint.sh /usr/local/bin/myflowhub-mcp-entrypoint

RUN chmod +x /usr/local/bin/myflowhub-mcp-entrypoint \
    && mkdir -p /data

EXPOSE 17688
VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/myflowhub-mcp-entrypoint"]
